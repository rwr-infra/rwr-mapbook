# 示例配置 —— 复制成 creds.env 再填你自己的值。
#
#     copy creds.example.env creds.env
#
# ⚠️ creds.env 里是真密钥：不要提交、不要发给别人、不要贴到任何地方。
#    真正要分享这个目录时（发给同事、打包上传），先删掉 creds.env。

# R2 的 S3 接口地址：https://<你的账户ID>.r2.cloudflarestorage.com
# 账户 ID 在 Cloudflare 面板 → R2 → 概览 右上角能看到。
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# 在 R2 → 管理 API 令牌 里创建「账户 API 令牌」，权限给 Object Read & Write
# （要删文件就得带 Write）。创建出来的一对值填这里。
R2_ACCESS_KEY_ID=<填你的>
R2_SECRET_ACCESS_KEY=<填你的>

# 桶名与前缀。本站：公开地址
#   https://assets.rwr-infra.uk/rwrme-web-assets/<文件名>
# 在 S3 侧对应「桶 assets + 前缀 rwrme-web-assets/」。
# 换到你自己的桶就改这两行。
R2_BUCKET=assets
R2_PREFIX=rwrme-web-assets

# 页面上写给人看的公开地址前缀（改域名/换存储时改这里）
R2_PUBLIC_BASE=https://assets.rwr-infra.uk/rwrme-web-assets
